@page
@model IndexModel
@{
    ViewData["Title"] = "Aquamancy";
}
<div class="row align-items-center mb-3 position-fixed top-0 start-0 w-100">
    <div class="col-2" style="overflow: hidden;">
        <div id="time" class="text-start text-center" style="font-size:clamp(1.5rem, 5vw, 6rem);">
        </div>
        <div class="text-center" style="font-size:2rem;">
            @System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(DateTime.Now.ToString("dddd dd MMMM yyyy"))
        </div>
        <div class="progress mt-2 mx-3" role="progressbar" aria-label="Temps avant le prochain rafraîchissement" aria-valuemin="0" aria-valuemax="100" style="height: 0.75rem;">
            <div id="refreshProgressBar" class="progress-bar bg-secondary" style="width: 0%;"></div>
        </div>
        <div class="text-center text-light mt-1 mx-3" style="font-size:0.75rem;">
            Prochain rafraîchissement de la page
        </div>
        <div class="text-center mt-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#appSettingsModal">
                <i class="bi bi-gear-fill"></i> Paramètres de l'application
            </button>
        </div>
        @if(Model.ErrorTriggerLogic.HasError)
        {
            <div class="alert alert-danger" role="alert">
                <div class="accordion accordion-flush" id="accordion">
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-transparent text-danger fw-bold" style="font-size: 1.5rem;" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                <i class="bi bi-exclamation-triangle-fill me-5" style="font-size: 6rem;"></i>
                                Il y a des erreurs, cliquez pour voir les détails
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordion">
                            <div class="accordion-body">
                                <div>
                                    @Model.ErrorTriggerLogic.LastInfoMessage
                                </div>
                                <div>
                                    @Model.ErrorTriggerLogic.LastException?.Message
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-10">
        <div class="row">
            <div class="col-6">
                <div class="card-body mb-8" style="position: relative;height: 65vh;background-color: rgba(13, 110, 253, 0.06);border-radius: 0.5rem;">
                    <canvas id="temperatureChart"></canvas>
                </div>
            </div>
            <div class="col-6">
                <div class="card-body mb-8" style="position: relative;height: 65vh;background-color: rgba(25, 135, 84, 0.06);border-radius: 0.5rem;">
                    <canvas id="tdsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row position-fixed bottom-0 start-0 w-100 m-1">
    @foreach (var tableInfo in Model.TableInformations)
    {
        // La carte clignote uniquement si la sonde ne communique plus ou si la température est hors plage,
        // pas en cas d'erreur capteur (température ou TDS)
        var cardStyle = (tableInfo.TemperatureReading == null && !tableInfo.HasTemperatureError) ||
                        (tableInfo.TemperatureReading != null && (tableInfo.TemperatureReading.Temperature < tableInfo.Probe.MinTemperature ||
                        tableInfo.TemperatureReading.Temperature > tableInfo.Probe.MaxTemperature))
            ? "text-bg-warning-custom"
            : "text-bg-light";



        var wifiIcon = tableInfo.TemperatureReading == null && !tableInfo.HasTemperatureError
            ? "bi-wifi-off"
            : tableInfo.Probe.RssiQuality switch
            {
                Aquamancy.Models.SignalQuality.Excellent => "bi-wifi",
                Aquamancy.Models.SignalQuality.Good => "bi-wifi",
                Aquamancy.Models.SignalQuality.Fair => "bi-wifi-2",
                Aquamancy.Models.SignalQuality.Weak => "bi-wifi-1",
                Aquamancy.Models.SignalQuality.VeryPoor => "bi-wifi-1",
                _ => "bi-question-circle"
            };

        var wifiColor = tableInfo.TemperatureReading == null && !tableInfo.HasTemperatureError
            ? "text-danger"
            : tableInfo.Probe.RssiQuality switch
            {
                Aquamancy.Models.SignalQuality.Excellent => "text-success",
                Aquamancy.Models.SignalQuality.Good => "text-success",
                Aquamancy.Models.SignalQuality.Fair => "text-warning",
                Aquamancy.Models.SignalQuality.Weak => "text-danger",
                Aquamancy.Models.SignalQuality.VeryPoor => "text-danger",
                _ => "text-secondary"
            };

        var statusMessages = new List<string>();
        if (tableInfo.TemperatureReading == null && !tableInfo.HasTemperatureError)
        {
            statusMessages.Add("La sonde ne communique plus : passez en mode appairage et vérifiez la connexion wifi");
        }
        if (tableInfo.HasTemperatureError)
        {
            statusMessages.Add("Erreur du capteur de température : vérifiez les branchements");
        }
        if (tableInfo.HasTdsError)
        {
            statusMessages.Add("Erreur du capteur TDS : vérifiez les branchements");
        }

        var headerStyle = $"background-color:{tableInfo.Probe.Color};overflow:hidden;";

        <div class="col-auto gx-2" style="width: 220px;">
            <div class="card mb-3 text-center p-0 probe-card position-relative" style="width: 100%; height: 240px; font-size: 2rem; cursor: pointer; overflow: hidden;"
                 data-probe-id="@tableInfo.Probe.Id" data-status="@string.Join("\n", statusMessages)" role="button" tabindex="0">
                <div class="probe-settings-overlay">
                    <i class="bi bi-gear-fill probe-settings-gear"></i>
                    <span class="probe-settings-text">Cliquez pour paramétrer la sonde</span>
                </div>
                <div class="card-header" style="@headerStyle">
                    <span class="probe-name d-inline-block text-nowrap">@tableInfo.Probe.Name.ToUpper()</span>
                </div>
                <div class="card-body @(cardStyle) text-center" style="padding: 6px !important;">
                    @{
                        var mainTempColor = "";
                        if(tableInfo.TemperatureReading != null)
                        {
                            if (tableInfo.TemperatureReading.Temperature < tableInfo.Probe.MinTemperature)
                            {
                                mainTempColor = Model.coldColor;
                            }
                            else if (tableInfo.TemperatureReading.Temperature > tableInfo.Probe.MaxTemperature)
                            {
                                mainTempColor = Model.hotColor;
                            }
                        }
                    }
                    @{
                        var temperatureDisplay = new Aquamancy.Dto.ReadingDisplayDto
                        {
                            Label = "Température",
                            Value = tableInfo.TemperatureReading?.Temperature,
                            Unit = "°C",
                            ValueColor = mainTempColor
                        };
                        var tdsDisplay = new Aquamancy.Dto.ReadingDisplayDto
                        {
                            Label = "TDS",
                            Value = tableInfo.TdsReading?.Tds,
                            ValueFormat = "F0",
                            Unit = "ppm"
                        };
                    }
                    <div class="row mx-0">
                        <div class="@(tableInfo.TdsReading != null || tableInfo.HasTdsError ? "col-6" : "col-12") px-1">
                            @if (tableInfo.HasTemperatureError)
                            {
                                <p style="font-size: 0.75rem;" class="card-text m-0 text-muted">Température</p>
                                <h5 style="font-size: 2.5rem;" class="card-text m-0">
                                    <i class="bi bi-thermometer-half text-danger"></i>
                                </h5>
                                <p style="font-size: 0.85rem;" class="card-text m-0 text-danger">Erreur</p>
                            }
                            else if (tableInfo.TemperatureReading == null)
                            {
                                <p style="font-size: 0.75rem;" class="card-text m-0 text-muted">Température</p>
                                <h5 style="font-size: 2.5rem;" class="card-text m-0">
                                    <i class="bi bi-wifi-off text-danger"></i>
                                </h5>
                                <p style="font-size: 0.85rem;" class="card-text m-0 text-danger">Hors ligne</p>
                            }
                            else
                            {
                                <partial name="_ReadingDisplay" model="temperatureDisplay" />
                            }
                        </div>
                        @if (tableInfo.HasTdsError)
                        {
                            <div class="col-6 px-1 border-start">
                                <p style="font-size: 0.75rem;" class="card-text m-0 text-muted">TDS</p>
                                <h5 style="font-size: 2.5rem;" class="card-text m-0">
                                    <i class="bi bi-droplet-half text-danger"></i>
                                </h5>
                                <p style="font-size: 0.85rem;" class="card-text m-0 text-danger">Erreur</p>
                            </div>
                        }
                        else if (tableInfo.TdsReading != null)
                        {
                            <div class="col-6 px-1 border-start">
                                <partial name="_ReadingDisplay" model="tdsDisplay" />
                            </div>
                        }
                    </div>
                    <p style="font-size: 1.1rem;" class="card-text m-0 mt-1"><b style="color:@Model.coldColor;">@($"{tableInfo.Probe.MinTemperature}°C")</b> - <b style="color:@Model.hotColor;">@($"{tableInfo.Probe.MaxTemperature}°C")</b></p>
                    <p style="font-size: 0.9rem;" class="card-text m-0">
                        Freq : <b>@tableInfo.Probe.SendFrequencyInSeconds sec</b>
                    </p>
                    <p style="font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" class="card-text m-0">
                        Dernière com : <b>@tableInfo.Probe.LastCommunicationAgoDisplay</b>
                        @if (tableInfo.Probe.RssiQuality != Aquamancy.Models.SignalQuality.Unknown)
                        {
                            <i style="font-size: 0.9rem;" class="bi @wifiIcon @wifiColor"></i>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="appSettingsModal" tabindex="-1" aria-labelledby="appSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveSettings">
                <div class="modal-header">
                    <h5 class="modal-title" id="appSettingsModalLabel">Paramètres de l'application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info" role="alert" style="font-size:0.85rem;">
                        Les modifications sont écrites dans <code>appsettings.json</code>. Certains paramètres peuvent nécessiter un redémarrage de l'application.
                    </div>

                    <h6 class="border-bottom pb-1">Graphique</h6>
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.DisplayLastHoursTemperature" class="form-label mb-0">Historique température (heures)</label>
                            <div class="form-text mt-0 mb-1">De combien d'heures en arrière les données de température démarrent-elles</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.DisplayLastHoursTemperature" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.DisplayLastHoursTds" class="form-label mb-0">Historique TDS (heures)</label>
                            <div class="form-text mt-0 mb-1">De combien d'heures en arrière les données de TDS démarrent-elles</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.DisplayLastHoursTds" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.FontSizeMultiplier" class="form-label mb-0">Taille de police</label>
                            <div class="form-text mt-0 mb-1">Facteur affectant la taille de la police dans le graphique</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.FontSizeMultiplier" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.RefreshIntervalInSeconds" class="form-label mb-0">Rafraîchissement (s)</label>
                            <div class="form-text mt-0 mb-1">Intervalle de rafraîchissement de la page du graphique en secondes</div>
                            <input type="number" min="5" class="form-control" asp-for="AppSettings.RefreshIntervalInSeconds" />
                        </div>
                        </div>

                    <h6 class="border-bottom pb-1">Discord</h6>
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label class="form-label mb-0">Notifications</label>
                            <div class="form-text mt-0 mb-1">Activer/Désactiver les notifications Discord et le service de notification</div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="AppSettings.NotificationEnabled" />
                                <label class="form-check-label" asp-for="AppSettings.NotificationEnabled">Notifications activées</label>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.WebhookUrl" class="form-label mb-0">URL du webhook</label>
                            <div class="form-text mt-0 mb-1">URL du webhook Discord pour les notifications (peut être généré depuis les paramètres du serveur Discord)</div>
                            <input type="text" class="form-control" asp-for="AppSettings.WebhookUrl" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.AlertFrequencyInHours" class="form-label mb-0">Rappel d'alerte (heures)</label>
                            <div class="form-text mt-0 mb-1">Si une sonde est en alerte, à quelle fréquence (en heures) envoyer une notification de rappel</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.AlertFrequencyInHours" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.DiscordCheckIntervalMinutes" class="form-label mb-0">Intervalle de vérification (minutes)</label>
                            <div class="form-text mt-0 mb-1">Intervalle en minutes entre chaque passage du service de vérification des températures pour envoi de notifications Discord (n'override pas le rappel d'alerte)</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.DiscordCheckIntervalMinutes" />
                        </div>
                    </div>

                    <h6 class="border-bottom pb-1">DeadManSwitch</h6>
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label class="form-label mb-0">Service DeadManSwitch</label>
                            <div class="form-text mt-0 mb-1">Activer/Désactiver le service DeadManSwitch (penser à le désactiver aussi côté Azure, ou à défaut changer le webhook Discord pour ne plus se faire spammer)</div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="AppSettings.DeadManSwitchEnabled" />
                                <label class="form-check-label" asp-for="AppSettings.DeadManSwitchEnabled">Activé</label>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.HealthCheckUrl" class="form-label mb-0">URL de health check</label>
                            <div class="form-text mt-0 mb-1">URL de l'application Azure à pinguer pour vérifier que l'application tourne</div>
                            <input type="text" class="form-control" asp-for="AppSettings.HealthCheckUrl" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.ErrorThreshold" class="form-label mb-0">Seuil d'erreurs consécutives</label>
                            <div class="form-text mt-0 mb-1">Nombre d'erreurs consécutives avant de déclencher l'alerte</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.ErrorThreshold" />
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.DeadManSwitchCheckIntervalMinutes" class="form-label mb-0">Intervalle de vérification (minutes)</label>
                            <div class="form-text mt-0 mb-1">Intervalle entre chaque vérification en minutes</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.DeadManSwitchCheckIntervalMinutes" />
                        </div>
                    </div>

                    <h6 class="border-bottom pb-1">Erreurs sur l'interface</h6>
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label class="form-label mb-0">Affichage des erreurs</label>
                            <div class="form-text mt-0 mb-1">Activer/Désactiver l'affichage des erreurs sur l'interface graphique, utile si l'intégration avec Discord ne marche plus</div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="AppSettings.ErrorOnGuiEnabled" />
                                <label class="form-check-label" asp-for="AppSettings.ErrorOnGuiEnabled">Affichage des erreurs activé</label>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mb-3">
                            <label asp-for="AppSettings.TimeBeforeClearingErrorsInMinutes" class="form-label mb-0">Effacement des erreurs (minutes)</label>
                            <div class="form-text mt-0 mb-1">Temps en minutes avant de retirer les erreurs affichées sur l'interface graphique</div>
                            <input type="number" min="1" class="form-control" asp-for="AppSettings.TimeBeforeClearingErrorsInMinutes" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="probeSettingsModal" tabindex="-1" aria-labelledby="probeSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="probeSettingsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="probe-Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="probeSettingsModalLabel">Paramétrer la sonde</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div id="probeSettingsError" class="alert alert-danger d-none" role="alert"></div>
                    <div id="probeStatusInfo" class="alert alert-warning d-none" role="alert" style="white-space: pre-line;"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="probe-Name" class="form-label mb-0">Nom</label>
                            <div class="form-text mt-0 mb-1">Nom d'affichage</div>
                            <input type="text" class="form-control" name="Name" id="probe-Name" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="probe-MachineName" class="form-label mb-0">Nom machine</label>
                            <div class="form-text mt-0 mb-1">Identifiant du microcontrôleur</div>
                            <input type="text" class="form-control" id="probe-MachineName" readonly disabled />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="probe-MinTemperature" class="form-label mb-0" style="color:@Model.coldColor;">Température min (°C)</label>
                            <div class="form-text mt-0 mb-1">Seuil minimum avant alerte</div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="range" class="form-range flex-grow-1 probe-slider" data-number="probe-MinTemperature" min="0" max="40" step="1" />
                                <input type="number" step="1" class="form-control probe-number" style="max-width: 6rem;" name="MinTemperature" id="probe-MinTemperature" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="probe-MaxTemperature" class="form-label mb-0" style="color:@Model.hotColor;">Température max (°C)</label>
                            <div class="form-text mt-0 mb-1">Seuil maximum avant alerte</div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="range" class="form-range flex-grow-1 probe-slider" data-number="probe-MaxTemperature" min="0" max="40" step="1" />
                                <input type="number" step="1" class="form-control probe-number" style="max-width: 6rem;" name="MaxTemperature" id="probe-MaxTemperature" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="probe-Color" class="form-label mb-0">Couleur</label>
                            <div class="form-text mt-0 mb-1">Couleur d'affichage</div>
                            <input type="color" class="form-control form-control-color" name="Color" id="probe-Color" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="probe-SendFrequencyInSeconds" class="form-label mb-0">Fréquence d'envoi (secondes)</label>
                            <div class="form-text mt-0 mb-1">Fréquence à laquelle la sonde envoie des données au serveur</div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="range" class="form-range flex-grow-1 probe-slider" data-number="probe-SendFrequencyInSeconds" min="1" max="3600" step="1" />
                                <input type="number" step="1" min="1" class="form-control probe-number" style="max-width: 6rem;" name="SendFrequencyInSeconds" id="probe-SendFrequencyInSeconds" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="probe-TdsEnabled" class="form-label mb-0">Capteur TDS</label>
                            <div class="form-text mt-0 mb-1">Si désactivé, l'absence de données TDS n'est pas considérée comme une erreur</div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" name="TdsEnabled" value="true" id="probe-TdsEnabled" />
                                <label class="form-check-label" for="probe-TdsEnabled">Activé</label>
                            </div>
                        </div>
                        </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js"></script>
    <script src="~/lib/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script>
        window.aquamancyConfig = {
            fontSizeMultiplier: @(Model._fontSizeMultiplier),
            pageRefreshIntervalInMilliseconds: @(Model._pageRefreshIntervalInMiliSeconds),
            coldColor: '@Model.coldColor',
            temperatureChart: @(Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TemperatureChart))),
            tdsChart: @(Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TdsChart)))
        };
    </script>
}